{
  "name": "rulegenix",
  "version": "0.0.1",
  "description": "Prototype rules generator",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "rulegenix": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run typecheck && tsup src/cli.ts --format esm --out-dir dist --sourcemap",
    "clean": "rm -rf dist",
    "dev": "tsup src/cli.ts --watch --format esm --out-dir dist --sourcemap",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,md}\"",
    "lint": "eslint src",
    "llm-test": "npm run clean && npm run build && npm run start -- llm-test -c data/config.yaml",
    "research-agent": "npm run clean && npm run build && npm run start -- research-agent -c data/config.yaml -s \"log4j 1.x to 2.x migration\"",
    "start": "node dist/cli.js",
    "test": "npm run clean && node --experimental-vm-modules node_modules/.bin/jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.799.0",
    "@langchain/anthropic": "^0.3.20",
    "@langchain/aws": "^0.1.9",
    "@langchain/community": "^0.3.42",
    "@langchain/core": "^0.3.51",
    "@langchain/google-genai": "^0.2.5",
    "@langchain/groq": "^0.2.2",
    "@langchain/langgraph": "^0.2.67",
    "@langchain/openai": "^0.5.10",
    "@langchain/tavily": "^0.1.1",
    "@langchain/textsplitters": "^0.1.0",
    "@langchain/xai": "^0.0.2",
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0",
    "langchain": "^0.3.24",
    "source-map-support": "^0.5.21",
    "tslog": "^4.9.3",
    "tsx": "^4.19.4",
    "yargs": "^17.7.2",
    "zod": "^3.24.3",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "@types/yargs": "^17.0.33",
    "eslint-config-prettier": "^10.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
